{
  "name": "hogkill",
  "version": "0.2.0",
  "description": "Interactive terminal tool to find and kill the processes hogging your machine",
  "keywords": [
    "cli",
    "tui",
    "process",
    "kill",
    "cpu",
    "memory",
    "ram",
    "top",
    "htop",
    "npkill"
  ],
  "license": "MIT",
  "author": "Igor Duca <yelldutz@gmail.com>",
  "homepage": "https://github.com/igorfelipeduca/hogkill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorfelipeduca/hogkill.git"
  },
  "bugs": {
    "url": "https://github.com/igorfelipeduca/hogkill/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "hogkill": "dist/cli.js",
    "hk": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
